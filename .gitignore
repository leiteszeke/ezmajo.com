# Secrets (DB credentials) - never commit
wp-config.php

# WordPress runtime / temp
wp-content/upgrade/
wp-content/upgrade-temp-backup/
wp-content/cache/
wp-content/backup*/
*.log
.DS_Store

# Cache Enabler runtime files (regenerated by the plugin)
wp-content/advanced-cache.php
# Redis Object Cache drop-in (created by `wp redis enable` on the server)
wp-content/object-cache.php
wp-content/settings/

# Local staging (ops/staging): Apache rules, staging-only mounts, debug log
.htaccess
wp-content/mu-plugins/staging-mail.php
wp-content/debug.log

# Paid pattern PDFs (WooCommerce protected downloads) - NEVER commit: this repo is public
wp-content/uploads/woocommerce_uploads/

# WooCommerce logs (may contain customer data)
wp-content/uploads/wc-logs/

# Local staging secrets (Gemini key)
ops/staging/.env

# Local import test files
ops/staging/import-test/

# Staging-only media from importer tests (attachments exist only in the local DB)
wp-content/uploads/2026/09/blusa-japonesa-*
wp-content/uploads/2026/09/jersey-flores*
wp-content/uploads/2026/09/vestido-infantil*

# Local tooling (not part of the site)
.playwright-mcp/
.vercel/
