{"translation-revision-date":"2023-10-17 14:49:22+0000","generator":"WP-CLI\/2.12.0","source":"public\/build\/extendify-shared-21b8b87f49c311a3e0b0.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ja_JP","plural-forms":"nplurals=1; plural=0;"},"Close":["\u9589\u3058\u308b"],"Close ToolTip":["\u8aac\u660e\u3092\u9589\u3058\u308b"],"Tooltip pointing to the edit page button":["\u7de8\u96c6\u30da\u30fc\u30b8\u3078\u79fb\u52d5\u3059\u308b\u30dc\u30bf\u30f3"],"Welcome to your new site! When you're ready, press here to edit this page.":["\u30db\u30fc\u30e0\u30da\u30fc\u30b8\u304c\u5b8c\u6210\u3057\u307e\u3057\u305f\uff01\u3053\u306e\u30da\u30fc\u30b8\u3092\u7de8\u96c6\u3059\u308b\u306b\u306f\u3001\u3053\u3061\u3089\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Setup complete":["\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u5b8c\u4e86"],"Term of Service":["\u5229\u7528\u898f\u7d04"],"Email address":["\u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9"],"No thanks":["\u7d50\u69cb\u3067\u3059"],"Setting up your plugin account":["\u30d7\u30e9\u30b0\u30a4\u30f3\u30a2\u30ab\u30a6\u30f3\u30c8\u306e\u8a2d\u5b9a"],"You can close this window. We will finish creating your account in the background.":["\u3053\u306e\u30a6\u30a3\u30f3\u30c9\u30a6\u306f\u9589\u3058\u3066\u69cb\u3044\u307e\u305b\u3093\u3002\u30a2\u30ab\u30a6\u30f3\u30c8\u306e\u4f5c\u6210\u306f\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u3067\u5b8c\u4e86\u3057\u307e\u3059\u3002"],"Your plugin account has been set up. Account activation may take a moment to complete.":["\u30d7\u30e9\u30b0\u30a4\u30f3\u30a2\u30ab\u30a6\u30f3\u30c8\u306e\u8a2d\u5b9a\u304c\u5b8c\u4e86\u3057\u307e\u3057\u305f\u3002\u30a2\u30ab\u30a6\u30f3\u30c8\u306e\u6709\u52b9\u5316\u306b\u306f\u5c11\u3057\u6642\u9593\u304c\u304b\u304b\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002"],"Almost done! Let's finish setting up your plugin":["\u3042\u3068\u5c11\u3057\u3067\u3059\uff01\u30d7\u30e9\u30b0\u30a4