on.":["\u7de8\u96c6\u30dc\u30bf\u30f3\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u30e6\u30fc\u30b6\u30fc\u306e\u5f79\u5272\u3092\u5909\u66f4\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u7ba1\u7406\u3001\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u60c5\u5831\u3092\u5909\u66f4\u3057\u307e\u3059\u3002"],"Edit user information":["\u30e6\u30fc\u30b6\u30fc\u60c5\u5831\u3092\u7de8\u96c6"],"See all of your users, including admin users in this table.":["\u3053\u306e\u30c6\u30fc\u30d6\u30eb\u306e\u7ba1\u7406\u8005\u3092\u542b\u3081\u305f\u5168\u30e6\u30fc\u30b6\u30fc\u3092\u78ba\u8a8d\u3059\u308b\u3002"],"Users":["\u30e6\u30fc\u30b6\u30fc"],"Click here to view and manage the users on your site.":["\u3053\u3061\u3089\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u30db\u30fc\u30e0\u30da\u30fc\u30b8\u306e\u30e6\u30fc\u30b6\u30fc\u3092\u95b2\u89a7\u3001\u7ba1\u7406\u3059\u308b\u3002"],"All Users menu":["\u5168\u30e6\u30fc\u30b6\u30fc\u306e\u30e1\u30cb\u30e5\u30fc"],"Click here to add another plugin to your site.":["\u3053\u3061\u3089\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u30db\u30fc\u30e0\u30da\u30fc\u30b8\u306b\u305d\u306e\u4ed6\u306e\u30d7\u30e9\u30b0\u30a4\u30f3\u3092\u8ffd\u52a0"],"Add another":["\u305d\u306e\u4ed6\u3092\u8ffd\u52a0"],"Under each plugin you can activate or deactivate it.":["\u305d\u308c\u305e\u308c\u306e\u30d7\u30e9\u30b0\u30a4\u30f3\u306e\u4e0b\u3067\u6709\u52b9\u5316\u307e\u305f\u306f\u7121\u52b9\u5316\u304c\u3067\u304d\u307e\u3059\u3002"],"Deactivate\/activate option":["\u7121\u52b9\u5316\/\u6709\u52b9\u5316\u30aa\u30d7\u30b7\u30e7\u30f3"],"See all plugins installed on your site. This includes plugins that are active and deactivated.":["\u30db\u30fc\u30e0\u30da\u30fc\u30b8\u306b\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u6e08\u307f\u306e\u5168\u3066\u306e\u30d7\u30e9\u30b0\u30a4\u30f3\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6709\u52b9\u306a\u30d7\u30e9\u30b0\u30a4\u30f3\u3068\u7121\u52b9\u306a\u30d7\u30e9\u30b0\u30a4\u30f3\u306e\u4e21\u65b9\u304c\u542b\u307