msgstr "Pilih asisten AI Anda untuk melihat cara menyambungkannya."

#. translators: %s: this site's name, offered as an example name for the connection.
#: app/Mcp/Profile.php:552
#, php-format
msgid "Anything you'll recognize, like %s."
msgstr "Apa pun yang Anda kenali, seperti %s."

#. translators: button label for two seconds after the text was copied.
#: app/Mcp/Profile.php:582
msgid "Copied"
msgstr "Disalin"

#. translators: button that copies the text beside it.
#: app/Mcp/Profile.php:584
msgid "Copy"
msgstr "Salin"

#. translators: 1: a person's name. 2: a date and time. No assistant works until this is undone.
#: app/Mcp/Profile.php:614
#, php-format
msgid "%1$s turned connections off for the whole site on %2$s. None work until they're turned back on."
msgstr "%1$s mematikan koneksi untuk seluruh situs pada %2$s. Tidak ada yang berfungsi hingga dinyalakan kembali."

#. translators: %s: a date and time. No assistant works until this is undone.
#: app/Mcp/Profile.php:623
#, php-format
msgid "Connections were turned off for the whole site on %s. None work until they're turned back on."
msgstr "Koneksi dinonaktifkan untuk seluruh situs pada %s. Tidak ada yang berfungsi hingga diaktifkan kembali."

#. translators: button that re-enables connections for the whole site.
#: app/Mcp/Profile.php:640
msgid "Turn connections back on"
msgstr "Aktifkan kembali koneksi"

#. translators: empty state under that heading.
#: app/Mcp/Profile.php:654
msgid "No assistants have been authorized yet."
msgstr "Belum ada asisten yang diotorisasi."

#. translators: badge on a connection that no longer works.
#: app/Mcp/Profile.php:694
