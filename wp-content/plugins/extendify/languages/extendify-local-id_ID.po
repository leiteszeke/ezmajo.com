msgstr "Cabut \"%s\""

#. translators: button that ends an assistant's access.
#: app/Mcp/Profile.php:700
msgid "Revoke"
msgstr "Cabut"

#. translators: why a connection stopped working, and the fix. Revoke is the button beside this message; use its label.
#: app/Mcp/Profile.php:704
msgid "This site's address or security keys changed, so this connection stopped working. Revoke it and connect the assistant again."
msgstr "Alamat atau kunci keamanan situs ini diubah, sehingga koneksi ini berhenti berfungsi. Cabut koneksinya dan sambungkan kembali asisten."

#. translators: %s: how long ago, such as "2 hours".
#: app/Mcp/Profile.php:733
